#!/bin/bash
# Perimeter Tripwire daemon.
set -u
source "$(dirname "$0")/../lib/common.sh"
source "$TW_HOME/lib/notify.sh"
source "$TW_HOME/lib/enrich.sh"
source "$TW_HOME/lib/snapshot.sh"
for m in "$TW_HOME"/lib/mod_*.sh; do [ -f "$m" ] && source "$m"; done

cmd=${1:-run}
case "$cmd" in
  test)
    tw_log test info msg="manual test"
    tw_notify "Tripwire test" "Logging and notifications work."
    echo "ok: $TW_EVENTS"; exit 0 ;;
  tail) exec tail -f "$TW_EVENTS" ;;
  report) shift; exec /usr/bin/python3 -I "$TW_HOME/bin/report.py" "$TW_EVENTS" "${1:-1}" ;;
  status)
    L="gui/$(id -u)/com.$(id -un).perimeter-tripwire"
    launchctl print "$L" 2>/dev/null | grep -E '^\s+(state|pid) ' || echo "launchd agent not loaded"
    pgrep -fl honeypot.py >/dev/null && echo "honeypot: running" || echo "honeypot: not running"
    echo "events: $(wc -l < "$TW_EVENTS" 2>/dev/null | tr -d ' ') lines, $(du -h "$TW_EVENTS" 2>/dev/null | cut -f1)"
    tail -1 "$TW_EVENTS"; exit 0 ;;
  who) shift; for ip in "$@"; do /bin/bash "$TW_HOME/bin/enrich-ip" "$ip"; echo "summary=$(tw_enrich_summary "$ip")"; echo; done; exit 0 ;;
  stop-honeypot) tw_hp_stop_all; echo stopped; exit 0 ;;
  scan)
    for fn in $(declare -F | awk '{print $3}' | grep '^tw_mod_'); do echo "running $fn"; "$fn"; done; exit 0 ;;
  run) ;;
  *) echo "usage: tripwire [run|test|tail|scan|status|report [days]|who <ip>...|stop-honeypot]"; exit 1 ;;
esac

trap 'tw_hp_stop_all 2>/dev/null; tw_log daemon.stop info; exit 0' TERM INT
tw_log daemon.start info pid="$$" host="$(hostname)" interval="$TW_INTERVAL"
tw_notify "Tripwire armed" "Monitoring $(hostname)." Pop

last_beat=$(date +%s)
while :; do
  for fn in $(declare -F | awk '{print $3}' | grep '^tw_mod_'); do
    "$fn" || tw_log module.error warn module="$fn"
  done
  now=$(date +%s)
  if (( now - last_beat >= TW_HEARTBEAT )); then
    tw_log daemon.heartbeat info; last_beat=$now
  fi
  sleep "$TW_INTERVAL"
done
